# Copy values into the protected OpenClaw environment; never commit the real file.
FRESHRSS_API_URL=https://rss.example.com/api/greader.php
FRESHRSS_API_USER=
FRESHRSS_API_PASSWORD=
FRESHRSS_DOCKER_CONTAINER=freshrss
FRESHRSS_DB_PATH=/var/www/FreshRSS/data/users/rssowner/db.sqlite
RSS_PUBLISH_TOKEN=
RSS_PUBLISH_DATA_ROOT=/home/ubuntu/.openclaw/rss-intelligence/publisher-data-v52
RSS_PUBLISH_PUBLIC_ROOT=/var/www/rss-intelligence
RSS_PUBLISH_BASE_URL=https://rss.example.com/intelligence
RSS_INTELLIGENCE_ROOT=/home/ubuntu/.openclaw/rss-intelligence
RSS_TRANSLATOR_AGENT=rss-v53-translator
RSS_TRANSLATOR_FLASH_MODEL=opencode-go/deepseek-v4-flash
RSS_TRANSLATOR_PRO_MODEL=opencode-go/deepseek-v4-pro
RSS_CLASSIFIER_AGENT=rss-v52-classifier
RSS_DAILY_FLASH_MODEL=opencode-go/deepseek-v4-flash
RSS_DAILY_PRO_MODEL=opencode-go/deepseek-v4-pro
# Optional relay; leave unset when using sources directly.
# RSS_SOURCE_RELAY_BASE=https://relay.example.net/.rss-source-bridge-v1
