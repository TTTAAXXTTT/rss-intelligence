    "freshrss_recent_articles": {
      "optional": true
    },
    "rss_report_save": {
      "optional": true
    },
    "rss_report_get_latest": {
      "optional": true
    },
    "rss_review_save": {
      "optional": true
    },
    "rss_review_get_pending": {
      "optional": true
    }
  }
